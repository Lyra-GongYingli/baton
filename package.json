{
  "name": "baton",
  "productName": "Baton",
  "version": "0.1.0",
  "description": "AI 时代的多线程任务接力工具：项目 → 任务 → 子任务，写提示词、看进程、排日程（macOS）",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Lyra-GongYingli",
  "homepage": "https://github.com/Lyra-GongYingli/baton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lyra-GongYingli/baton.git"
  },
  "bugs": {
    "url": "https://github.com/Lyra-GongYingli/baton/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "electron-vite build && NODE_OPTIONS=--experimental-require-module electron-builder --mac --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "com.lyra.baton",
    "productName": "Baton",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/trayTemplate*.png",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null
    }
  }
}
